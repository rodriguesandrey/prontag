@page "/gestao/usuarios"
@inject HttpClient Http
@using System.Net.Http.Json

<a class="voltar-botao" href="/gestao">← Voltar</a>

<div class="pagina-cabecalho">
    <h3>Usuários</h3>
    <p>Login de administradores e funcionários. Senha: pelo menos 4 números e 1 letra.</p>
</div>

<div><label>Nome: <input @bind="nome" /></label></div>
<div><label>Login: <input @bind="login" /></label></div>
<div>
    <label>Senha:
        <input type="@(mostrarSenha ? "text" : "password")" @bind="senha" />
    </label>
    <label style="display:inline-flex; align-items:center; gap:6px; font-size:0.85rem;">
        <input type="checkbox" style="width:auto" @bind="mostrarSenha" /> Mostrar
    </label>
</div>
<div>
    <label>Papel:
        <select @bind="papel">
            <option value="Funcionario">Funcionário</option>
            <option value="Admin">Admin</option>
        </select>
    </label>
</div>

<button class="principal" @onclick="Salvar" disabled="@salvando">
    @(salvando ? "Salvando..." : "Cadastrar usuário")
</button>
@if (!string.IsNullOrEmpty(mensagem))
{
    <p class="aviso">@mensagem</p>
}

@if (usuarios is not null && usuarios.Any(u => u.PedidoRedefinicao))
{
    <h4>Pedidos de redefinição de senha</h4>
    <table>
        <thead><tr><th>Nome</th><th>Login</th><th>Nova senha</th><th></th></tr></thead>
        <tbody>
            @foreach (var u in usuarios.Where(u => u.PedidoRedefinicao))
            {
                <tr>
                    <td>@u.Nome</td>
                    <td>@u.Login</td>
                    <td><input @bind="novasSenhas[u.Id]" placeholder="ex: novo1234" /></td>
                    <td><button class="principal" @onclick="() => Redefinir(u.Id)">Definir</button></td>
                </tr>
            }
        </tbody>
    </table>
}

<h4>Usuários cadastrados</h4>
@if (usuarios is null)
{
    <p>Carregando...</p>
}
else
{
    <table>
        <thead><tr><th>Nome</th><th>Login</th><th>Papel</th><th></th></tr></thead>
        <tbody>
            @foreach (var u in usuarios)
            {
                <tr>
                    <td>@u.Nome</td>
                    <td>@u.Login</td>
                    <td>@u.Papel</td>
                    <td><button @onclick="() => Remover(u.Id)">Remover</button></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<UsuarioDto>? usuarios;
    private Dictionary<Guid, string> novasSenhas = new();
    private string nome = "", login = "", senha = "", papel = "Funcionario";
    private bool mostrarSenha;
    private bool salvando;
    private string? mensagem;

    protected override async Task OnInitializedAsync() => await Carregar();

    private async Task Carregar()
    {
        usuarios = await Http.GetFromJsonAsync<List<UsuarioDto>>("usuarios");
    }

    private async Task Salvar()
    {
        salvando = true;
        var dados = new { Nome = nome, Login = login, Senha = senha, Papel = papel };
        var resposta = await Http.PostAsJsonAsync("usuarios", dados);

        if (resposta.IsSuccessStatusCode)
        {
            mensagem = $"Usuário \"{nome}\" cadastrado!";
            nome = login = senha = "";
            await Carregar();
        }
        else
        {
            mensagem = await resposta.Content.ReadAsStringAsync();
        }
        salvando = false;
    }

    private async Task Redefinir(Guid id)
    {
        if (!novasSenhas.TryGetValue(id, out var novaSenha) || string.IsNullOrWhiteSpace(novaSenha))
        {
            mensagem = "Digite a nova senha antes de confirmar.";
            return;
        }

        var resposta = await Http.PostAsync($"usuarios/{id}/redefinir-senha?novaSenha={novaSenha}", null);
        mensagem = resposta.IsSuccessStatusCode ? "Senha redefinida!" : "Erro ao redefinir senha.";
        await Carregar();
    }

    private async Task Remover(Guid id)
    {
        await Http.DeleteAsync($"usuarios/{id}");
        await Carregar();
    }

    private class UsuarioDto
    {
        public Guid Id { get; set; }
        public string Nome { get; set; } = "";
        public string Login { get; set; } = "";
        public string Papel { get; set; } = "";
        public bool PedidoRedefinicao { get; set; }
    }
}
