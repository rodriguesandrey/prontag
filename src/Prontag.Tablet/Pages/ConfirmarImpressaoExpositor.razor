@page "/confirmar-expositor/{ProdutoId:guid}"
@inject HttpClient Http
@inject NavigationManager Nav
@inject Prontag.Tablet.Services.ImpressoraService Impressora
@using Prontag.Domain
@using Prontag.Tablet.Services
@using System.Net.Http.Json

<a class="voltar-botao" href="/expositor">← Voltar</a>

<div class="pagina-cabecalho">
    <h3>Confira a etiqueta (Expositor)</h3>
</div>

<button @onclick="Conectar">🖨️ Conectar impressora</button>
@if (!string.IsNullOrEmpty(statusConexao))
{
    <p class="aviso">@statusConexao</p>
}

@if (produto is null)
{
    <p>Carregando...</p>
}
else if (sucesso)
{
    <p class="aviso">✅ Etiqueta impressa!</p>
}
else
{
    <div class="secao">
        <p><strong>Produto:</strong> @produto.Nome</p>
        <p><strong>Preço:</strong> @(produto.Preco.HasValue ? $"{produto.Preco:C}/{produto.Unidade}" : "não informado")</p>
        <p><strong>Fabricação:</strong> @fabricacao.ToString("dd/MM/yyyy")</p>
        <p><strong>Vencimento:</strong> @vencimento.ToString("dd/MM/yyyy")</p>
        <p><strong>Met. Armazenagem:</strong> @produto.MetodoArmazenagem</p>
    </div>

    <button class="principal" @onclick="Imprimir" disabled="@imprimindo">
        @(imprimindo ? "Imprimindo..." : "Imprimir etiqueta")
    </button>

    @if (!string.IsNullOrEmpty(statusImpressao))
    {
        <p class="aviso">@statusImpressao</p>
    }
}

@code {
    [Parameter] public Guid ProdutoId { get; set; }

    private Produto? produto;
    private DateOnly fabricacao;
    private DateOnly vencimento;
    private bool imprimindo;
    private bool sucesso;
    private string? statusConexao;
    private string? statusImpressao;

    protected override async Task OnInitializedAsync()
    {
        var produtos = await Http.GetFromJsonAsync<List<Produto>>("produtos");
        produto = produtos?.FirstOrDefault(p => p.Id == ProdutoId);

        fabricacao = DateOnly.FromDateTime(DateTime.Now);
        vencimento = fabricacao.AddDays(produto?.DiasValidade ?? 0);
        var nomeReconectado = await Impressora.ReconectarSilenciosamenteAsync();
if (nomeReconectado is not null)
{
    statusConexao = $"Conectado: {nomeReconectado}";
}
    }

    private async Task Conectar()
    {
        try
        {
            var nome = await Impressora.ConectarAsync();
            statusConexao = $"Conectado: {nome}";
        }
        catch (Exception ex)
        {
            statusConexao = $"Erro ao conectar: {ex.Message}";
        }
    }

    private async Task Imprimir()
    {
        imprimindo = true;
        var zpl = ZplBuilder.EtiquetaExpositor(
            produto!.Nome,
            produto.Preco,
            produto.Unidade,
            fabricacao,
            vencimento,
            produto.MetodoArmazenagem);

        try
        {
            await Impressora.ImprimirAsync(zpl);
            var request = new { ProdutoId, FuncionarioId = (Guid?)null, Tipo = 1 };
            var response = await Http.PostAsJsonAsync("impressoes", request);

            if (response.IsSuccessStatusCode)
            {
                sucesso = true;
                await Task.Delay(2000);
                Nav.NavigateTo("/");
            }
        }
        catch (Exception ex)
        {
            statusImpressao = $"Erro ao imprimir: {ex.Message}";
        }

        imprimindo = false;
    }
}
