@page "/gestao"
@inject NavigationManager Nav

<a class="voltar-botao" href="/">← Voltar</a>

<div class="pagina-cabecalho">
    <h3>Gestão</h3>
    <p>Produtos, funcionários, usuários e relatórios da operação.</p>
</div>

<div class="grade-cartoes">
    <div class="cartao cartao-b" @onclick='() => Nav.NavigateTo("/gestao/expositor-precos")'>
        <div class="cartao-icone icone-b">🛒</div>
        <h4>Etiquetas expositor</h4>
        <p>Cadastre itens e defina o preço de cada um para o expositor.</p>
    </div>
    <div class="cartao cartao-a" @onclick='() => Nav.NavigateTo("/gestao/produtos")'>
        <div class="cartao-icone icone-a">🏷️</div>
        <h4>Etiquetas produtos</h4>
        <p>Cadastre produtos e os dias de validade de cada um.</p>
    </div>
    <div class="cartao cartao-c" @onclick='() => Nav.NavigateTo("/gestao/funcionarios")'>
        <div class="cartao-icone icone-c">👥</div>
        <h4>Funcionários</h4>
        <p>Cadastre e edite a lista de funcionários.</p>
    </div>
    <div class="cartao cartao-d" @onclick='() => Nav.NavigateTo("/gestao/relatorios")'>
        <div class="cartao-icone icone-d">📊</div>
        <h4>Relatórios</h4>
        <p>Etiquetas emitidas por funcionário, filtradas por período.</p>
    </div>
    <div class="cartao cartao-c" @onclick='() => Nav.NavigateTo("/gestao/usuarios")'>
        <div class="cartao-icone icone-c">🔐</div>
        <h4>Usuários</h4>
        <p>Crie e remova logins de administradores e funcionários.</p>
    </div>
</div>
