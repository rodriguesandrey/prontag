@page "/funcionario/{ProdutoId:guid}"
@inject HttpClient Http
@inject NavigationManager Nav
@using Prontag.Domain

<a href="/produto">&lt; Voltar</a>
<h3>Quem está fazendo a etiqueta?</h3>

@if (funcionarios is null)
{
    <p>Carregando...</p>
}
else
{
    @foreach (var funcionario in funcionarios)
    {
        <button @onclick="() => Selecionar(funcionario)">
            @funcionario.Nome
        </button>
    }
}

@code {
    [Parameter]
    public Guid ProdutoId { get; set; }

    private List<Funcionario>? funcionarios;

    protected override async Task OnInitializedAsync()
    {
        funcionarios = await Http.GetFromJsonAsync<List<Funcionario>>("funcionarios");
    }

    private void Selecionar(Funcionario funcionario)
    {
        Nav.NavigateTo($"/confirmar/{ProdutoId}/{funcionario.Id}");
    }
}