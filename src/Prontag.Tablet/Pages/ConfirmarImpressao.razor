@page "/confirmar/{ProdutoId:guid}/{FuncionarioId:guid}"
@inject HttpClient Http
@inject NavigationManager Nav
@using Prontag.Domain
@using System.Net.Http.Json

<a href="/">&lt; Voltar</a>
<h3>Confira a etiqueta</h3>

@if (produto is null || funcionario is null)
{
    <p>Carregando...</p>
}
else if (sucesso)
{
    <p>✅ Etiqueta impressa!</p>
}
else
{
    <div>
        <p><strong>Produto:</strong> @produto.Nome</p>
        <p><strong>Fabricação:</strong> @DateTime.Now.ToString("dd/MM/yyyy")</p>
        <p><strong>Vencimento:</strong> @DateOnly.FromDateTime(DateTime.Now).AddDays(produto.DiasValidade).ToString("dd/MM/yyyy")</p>
        <p><strong>Responsável:</strong> @funcionario.Nome</p>
    </div>

    <button @onclick="Imprimir" disabled="@imprimindo">
        @(imprimindo ? "Imprimindo..." : "Imprimir etiqueta")
    </button>
}

@code {
    [Parameter] public Guid ProdutoId { get; set; }
    [Parameter] public Guid FuncionarioId { get; set; }

    private Produto? produto;
    private Funcionario? funcionario;
    private bool imprimindo;
    private bool sucesso;

    protected override async Task OnInitializedAsync()
    {
        var produtos = await Http.GetFromJsonAsync<List<Produto>>("produtos");
        produto = produtos?.FirstOrDefault(p => p.Id == ProdutoId);

        var funcionarios = await Http.GetFromJsonAsync<List<Funcionario>>("funcionarios");
        funcionario = funcionarios?.FirstOrDefault(f => f.Id == FuncionarioId);
    }

    private async Task Imprimir()
    {
        imprimindo = true;

        var request = new
        {
            ProdutoId,
            FuncionarioId,
            Tipo = 0 // TipoEtiqueta.Produto
        };

        var response = await Http.PostAsJsonAsync("impressoes", request);

        if (response.IsSuccessStatusCode)
        {
            sucesso = true;
            await Task.Delay(2000);
            Nav.NavigateTo("/");
        }

        imprimindo = false;
 
    }
}