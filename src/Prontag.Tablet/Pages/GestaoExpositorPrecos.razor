@page "/gestao/expositor-precos"
@inject HttpClient Http
@using Prontag.Domain
@using System.Net.Http.Json

<a class="voltar-botao" href="/gestao">← Voltar</a>

<div class="pagina-cabecalho">
    <h3>Etiquetas expositor</h3>
    <p>Cadastre itens e defina o preço de cada um.</p>
</div>

<div class="secao">
    <p class="secao-titulo">Novo item do expositor</p>
    <div class="campo"><label>Nome</label><input @bind="novoNome" /></div>
    <div class="campo"><label>Preço</label><input type="number" step="0.01" @bind="novoPreco" /></div>
    <button class="principal" @onclick="Cadastrar" disabled="@salvando">
        @(salvando ? "Salvando..." : "Cadastrar item")
    </button>
    @if (!string.IsNullOrEmpty(mensagem))
    {
        <p class="aviso">@mensagem</p>
    }
</div>

<div class="secao">
    <p class="secao-titulo">Itens cadastrados</p>
    @if (produtos is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <table>
            <thead><tr><th>Produto</th><th>Preço</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in produtos)
                {
                    <tr>
                        <td>@p.Nome</td>
                        <td><input type="number" step="0.01" @bind="precos[p.Id]" style="max-width:120px" /></td>
                        <td><button class="principal" @onclick="() => SalvarPreco(p)" disabled="@(salvandoId == p.Id)">Salvar</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Produto>? produtos;
    private Dictionary<Guid, decimal?> precos = new();
    private Guid? salvandoId;
    private string novoNome = "";
    private decimal? novoPreco;
    private bool salvando;
    private string? mensagem;

    protected override async Task OnInitializedAsync() => await Carregar();

    private async Task Carregar()
    {
        produtos = await Http.GetFromJsonAsync<List<Produto>>("produtos");
        if (produtos is not null)
        {
            foreach (var p in produtos) precos[p.Id] = p.Preco;
        }
    }

    private async Task Cadastrar()
    {
        if (string.IsNullOrWhiteSpace(novoNome))
        {
            mensagem = "Informe o nome do item.";
            return;
        }

        salvando = true;
        var dados = new { Nome = novoNome, DiasValidade = 0, Preco = novoPreco };
        var resposta = await Http.PostAsJsonAsync("produtos", dados);

        if (resposta.IsSuccessStatusCode)
        {
            mensagem = $"Item \"{novoNome}\" cadastrado!";
            novoNome = "";
            novoPreco = null;
            await Carregar();
        }
        else
        {
            mensagem = "Erro ao cadastrar item.";
        }
        salvando = false;
    }

    private async Task SalvarPreco(Produto produto)
    {
        salvandoId = produto.Id;
        var dados = new { Nome = produto.Nome, DiasValidade = produto.DiasValidade, Preco = precos[produto.Id], Icone = produto.Icone };
        var resposta = await Http.PutAsJsonAsync($"produtos/{produto.Id}", dados);

        mensagem = resposta.IsSuccessStatusCode
            ? $"Preço de \"{produto.Nome}\" atualizado!"
            : $"Erro ao atualizar \"{produto.Nome}\".";
        salvandoId = null;
    }
}
