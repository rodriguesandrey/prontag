@page "/gestao/expositor-precos"
@inject HttpClient Http
@using Prontag.Domain
@using System.Net.Http.Json

<a class="voltar-botao" href="/gestao">← Voltar</a>

<div class="pagina-cabecalho">
    <h3>Etiquetas expositor</h3>
    <p>Itens vendidos no expositor — nome, validade, preço, unidade e armazenagem.</p>
</div>

<div class="secao">
    <p class="secao-titulo">Novo item do expositor</p>
    <div class="linha-campos">
        <div class="campo"><label>Nome</label><input @bind="novoNome" /></div>
        <div class="campo"><label>Dias de validade</label><input type="number" @bind="novoDiasValidade" /></div>
        <div class="campo"><label>Preço</label><input type="number" step="0.01" @bind="novoPreco" /></div>
        <div class="campo">
            <label>Unidade</label>
            <select @bind="novaUnidade">
                <option value="kg">Quilo (kg)</option>
                <option value="un">Unidade</option>
                <option value="g">Grama (g)</option>
            </select>
        </div>
        <div class="campo">
            <label>Armazenagem</label>
            <select @bind="novoMetodoArmazenagem">
                <option value="Temp. Ambiente">Temp. Ambiente</option>
                <option value="Geladeira">Geladeira</option>
                <option value="Freezer">Freezer</option>
            </select>
        </div>
    </div>
    <button class="principal" @onclick="Cadastrar" disabled="@salvando">
        @(salvando ? "Salvando..." : "Cadastrar item")
    </button>
    @if (!string.IsNullOrEmpty(mensagem))
    {
        <p class="aviso">@mensagem</p>
    }
</div>

<div class="secao">
    <p class="secao-titulo">Itens cadastrados</p>
    @if (produtos is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Produto</th><th>Dias</th><th>Preço</th><th>Unidade</th><th>Armazenagem</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in produtos)
                {
                    <tr>
                        <td>@p.Nome</td>
                        <td><input type="number" @bind="dias[p.Id]" style="max-width:70px" /></td>
                        <td><input type="number" step="0.01" @bind="precos[p.Id]" style="max-width:100px" /></td>
                        <td>
                            <select @bind="unidades[p.Id]" style="max-width:90px">
                                <option value="kg">kg</option>
                                <option value="un">un</option>
                                <option value="g">g</option>
                            </select>
                        </td>
                        <td>
                            <select @bind="armazenagens[p.Id]" style="max-width:140px">
                                <option value="Temp. Ambiente">Temp. Ambiente</option>
                                <option value="Geladeira">Geladeira</option>
                                <option value="Freezer">Freezer</option>
                            </select>
                        </td>
                        <td><button class="principal" @onclick="() => SalvarItem(p)" disabled="@(salvandoId == p.Id)">Salvar</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Produto>? produtos;
    private Dictionary<Guid, decimal?> precos = new();
    private Dictionary<Guid, int> dias = new();
    private Dictionary<Guid, string> unidades = new();
    private Dictionary<Guid, string> armazenagens = new();
    private Guid? salvandoId;

    private string novoNome = "";
    private int novoDiasValidade;
    private decimal? novoPreco;
    private string novaUnidade = "kg";
    private string novoMetodoArmazenagem = "Temp. Ambiente";
    private bool salvando;
    private string? mensagem;

    protected override async Task OnInitializedAsync() => await Carregar();

    private async Task Carregar()
    {
        produtos = await Http.GetFromJsonAsync<List<Produto>>("produtos?contexto=expositor");
        if (produtos is not null)
        {
            foreach (var p in produtos)
            {
                precos[p.Id] = p.Preco;
                dias[p.Id] = p.DiasValidade;
                unidades[p.Id] = p.Unidade;
                armazenagens[p.Id] = p.MetodoArmazenagem;
            }
        }
    }

    private async Task Cadastrar()
    {
        if (string.IsNullOrWhiteSpace(novoNome))
        {
            mensagem = "Informe o nome do item.";
            return;
        }

        salvando = true;
        var dados = new
        {
            Nome = novoNome,
            DiasValidade = novoDiasValidade,
            Preco = novoPreco,
            UsadoEmProdutos = false,
            UsadoEmExpositor = true,
            Unidade = novaUnidade,
            MetodoArmazenagem = novoMetodoArmazenagem
        };
        var resposta = await Http.PostAsJsonAsync("produtos", dados);

        if (resposta.IsSuccessStatusCode)
        {
            mensagem = $"Item \"{novoNome}\" cadastrado!";
            novoNome = "";
            novoDiasValidade = 0;
            novoPreco = null;
            novaUnidade = "kg";
            novoMetodoArmazenagem = "Temp. Ambiente";
            await Carregar();
        }
        else
        {
            mensagem = "Erro ao cadastrar item.";
        }
        salvando = false;
    }

    private async Task SalvarItem(Produto produto)
    {
        salvandoId = produto.Id;
        var dados = new
        {
            Nome = produto.Nome,
            DiasValidade = dias[produto.Id],
            Preco = precos[produto.Id],
            Icone = produto.Icone,
            UsadoEmProdutos = produto.UsadoEmProdutos,
            UsadoEmExpositor = true,
            Unidade = unidades[produto.Id],
            MetodoArmazenagem = armazenagens[produto.Id]
        };
        var resposta = await Http.PutAsJsonAsync($"produtos/{produto.Id}", dados);

        mensagem = resposta.IsSuccessStatusCode
            ? $"\"{produto.Nome}\" atualizado!"
            : $"Erro ao atualizar \"{produto.Nome}\".";
        salvandoId = null;
    }
}
