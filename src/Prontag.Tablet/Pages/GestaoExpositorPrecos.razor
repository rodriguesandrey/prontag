@page "/gestao/expositor-precos"
@inject HttpClient Http
@using Prontag.Domain
@using System.Net.Http.Json

<a class="voltar-botao" href="/gestao">← Voltar</a>

<div class="pagina-cabecalho">
    <h3>Etiquetas expositor</h3>
    <p>Defina o preço de cada produto exibido no expositor.</p>
</div>

@if (!string.IsNullOrEmpty(mensagem))
{
    <p class="aviso">@mensagem</p>
}

@if (produtos is null)
{
    <p>Carregando...</p>
}
else
{
    <table>
        <thead><tr><th>Produto</th><th>Preço</th><th></th></tr></thead>
        <tbody>
            @foreach (var p in produtos)
            {
                <tr>
                    <td>@p.Nome</td>
                    <td><input type="number" step="0.01" @bind="precos[p.Id]" style="max-width:120px" /></td>
                    <td><button class="principal" @onclick="() => Salvar(p)" disabled="@(salvandoId == p.Id)">Salvar</button></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Produto>? produtos;
    private Dictionary<Guid, decimal?> precos = new();
    private Guid? salvandoId;
    private string? mensagem;

    protected override async Task OnInitializedAsync()
    {
        produtos = await Http.GetFromJsonAsync<List<Produto>>("produtos");
        if (produtos is not null)
        {
            foreach (var p in produtos)
            {
                precos[p.Id] = p.Preco;
            }
        }
    }

    private async Task Salvar(Produto produto)
    {
        salvandoId = produto.Id;
        var dados = new { Nome = produto.Nome, DiasValidade = produto.DiasValidade, Preco = precos[produto.Id], Icone = produto.Icone };
        var response = await Http.PutAsJsonAsync($"produtos/{produto.Id}", dados);

        mensagem = response.IsSuccessStatusCode
            ? $"Preço de \"{produto.Nome}\" atualizado!"
            : $"Erro ao atualizar \"{produto.Nome}\".";

        salvandoId = null;
    }
}
