@page "/gestao/expositor-precos"
@inject HttpClient Http
@using Prontag.Domain
@using System.Net.Http.Json

<a class="voltar-botao" href="/gestao">← Voltar</a>

<div class="pagina-cabecalho">
    <h3>Etiquetas expositor</h3>
    <p>Itens do expositor — nome, categoria, validade, preço, unidade e armazenagem.</p>
</div>

<div class="secao">
    <p class="secao-titulo">@(editandoId is null ? "Novo item do expositor" : "Editando item")</p>
    <div class="linha-campos">
        <div class="campo"><label>Nome</label><input @bind="nome" /></div>
        <div class="campo">
            <label>Categoria</label>
            <select @bind="grupo">
                @foreach (var c in Categorias.Todas)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>
        <div class="campo"><label>Dias de validade</label><input type="number" @bind="diasValidade" /></div>
        <div class="campo"><label>Preço</label><input type="number" step="0.01" @bind="preco" /></div>
        <div class="campo">
            <label>Unidade</label>
            <select @bind="unidade">
                <option value="kg">Quilo (kg)</option>
                <option value="un">Unidade</option>
                <option value="g">Grama (g)</option>
            </select>
        </div>
        <div class="campo">
            <label>Armazenagem</label>
            <select @bind="metodoArmazenagem">
                <option value="Temp. Ambiente">Temp. Ambiente</option>
                <option value="Geladeira">Geladeira</option>
                <option value="Freezer">Freezer</option>
            </select>
        </div>
    </div>
    <button class="principal" @onclick="Salvar" disabled="@salvando">
        @(salvando ? "Salvando..." : editandoId is null ? "Cadastrar item" : "Salvar edição")
    </button>
    @if (editandoId is not null)
    {
        <button @onclick="CancelarEdicao">Cancelar</button>
    }
    @if (!string.IsNullOrEmpty(mensagem))
    {
        <p class="aviso">@mensagem</p>
    }
</div>

<div class="secao">
    <p class="secao-titulo">Itens cadastrados</p>
    @if (produtos is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <table>
            <thead><tr><th>Produto</th><th>Categoria</th><th>Dias</th><th>Preço</th><th>Unidade</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in produtos)
                {
                    <tr>
                        <td>@p.Nome</td>
                        <td>@(string.IsNullOrEmpty(p.Grupo) ? "—" : p.Grupo)</td>
                        <td>@p.DiasValidade</td>
                        <td>@(p.Preco?.ToString("C") ?? "—")</td>
                        <td>@p.Unidade</td>
                        <td>
                            <button @onclick="() => EditarClique(p)">Editar</button>
                            <button @onclick="() => RemoverClique(p)">Deletar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Produto>? produtos;
    private Guid? editandoId;
    private string nome = "";
    private int diasValidade;
    private decimal? preco;
    private string unidade = "kg";
    private string metodoArmazenagem = "Temp. Ambiente";
    private string grupo = Categorias.Todas[0];
    private string? iconeAtual;
    private bool salvando;
    private string? mensagem;

    protected override async Task OnInitializedAsync() => await Carregar();

    private async Task Carregar()
    {
        produtos = await Http.GetFromJsonAsync<List<Produto>>("produtos?contexto=expositor");
    }

    private void EditarClique(Produto p)
    {
        editandoId = p.Id;
        nome = p.Nome;
        diasValidade = p.DiasValidade;
        preco = p.Preco;
        unidade = p.Unidade;
        metodoArmazenagem = p.MetodoArmazenagem;
        grupo = string.IsNullOrEmpty(p.Grupo) ? Categorias.Todas[0] : p.Grupo;
        iconeAtual = p.Icone;
        mensagem = null;
    }

    private void CancelarEdicao()
    {
        editandoId = null;
        nome = "";
        diasValidade = 0;
        preco = null;
        unidade = "kg";
        metodoArmazenagem = "Temp. Ambiente";
        grupo = Categorias.Todas[0];
        iconeAtual = null;
    }

    private async Task Salvar()
    {
        if (string.IsNullOrWhiteSpace(nome))
        {
            mensagem = "Informe o nome do item.";
            return;
        }

        salvando = true;
        var dados = new
        {
            Nome = nome,
            DiasValidade = diasValidade,
            Preco = preco,
            Icone = iconeAtual,
            UsadoEmProdutos = false,
            UsadoEmExpositor = true,
            Unidade = unidade,
            MetodoArmazenagem = metodoArmazenagem,
            Grupo = grupo
        };

        HttpResponseMessage response = editandoId is null
            ? await Http.PostAsJsonAsync("produtos", dados)
            : await Http.PutAsJsonAsync($"produtos/{editandoId}", dados);

        if (response.IsSuccessStatusCode)
        {
            mensagem = editandoId is null ? $"Item \"{nome}\" cadastrado!" : "Item atualizado!";
            CancelarEdicao();
            await Carregar();
        }
        else
        {
            mensagem = "Erro ao salvar item.";
        }
        salvando = false;
    }

    private async Task RemoverClique(Produto p)
    {
        var response = await Http.DeleteAsync($"produtos/{p.Id}");
        if (response.IsSuccessStatusCode) await Carregar();
        else mensagem = "Erro ao deletar item.";
    }
}