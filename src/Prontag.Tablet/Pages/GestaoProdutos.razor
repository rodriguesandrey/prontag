@page "/gestao/produtos"
@inject HttpClient Http
@using Prontag.Domain
@using System.Net.Http.Json

<a class="voltar-botao" href="/gestao">← Voltar</a>

<div class="pagina-cabecalho">
    <h3>Etiquetas produtos</h3>
    <p>Produtos de uso interno — nome, validade e armazenagem.</p>
</div>

<div class="secao">
    <p class="secao-titulo">@(editandoId is null ? "Novo produto" : "Editando produto")</p>
    <div class="linha-campos">
        <div class="campo"><label>Nome</label><input @bind="nome" /></div>
        <div class="campo"><label>Dias de validade</label><input type="number" @bind="diasValidade" /></div>
        <div class="campo">
            <label>Método de armazenagem</label>
            <select @bind="metodoArmazenagemAtual">
                <option value="Temp. Ambiente">Temp. Ambiente</option>
                <option value="Geladeira">Geladeira</option>
                <option value="Freezer">Freezer</option>
            </select>
        </div>
    </div>
    <button class="principal" @onclick="Salvar" disabled="@salvando">
        @(salvando ? "Salvando..." : editandoId is null ? "Cadastrar produto" : "Salvar edição")
    </button>
    @if (editandoId is not null)
    {
        <button @onclick="CancelarEdicao">Cancelar</button>
    }
    @if (!string.IsNullOrEmpty(mensagem))
    {
        <p class="aviso">@mensagem</p>
    }
</div>

<div class="secao">
    <p class="secao-titulo">Produtos cadastrados</p>
    @if (produtos is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <table>
            <thead><tr><th>Nome</th><th>Dias</th><th>Armazenagem</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in produtos)
                {
                    <tr>
                        <td>@p.Nome</td>
                        <td>@p.DiasValidade</td>
                        <td>@p.MetodoArmazenagem</td>
                        <td>
                            <button @onclick="() => EditarClique(p)">Editar</button>
                            <button @onclick="() => RemoverClique(p)">Remover</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Produto>? produtos;
    private Guid? editandoId;
    private string nome = "";
    private int diasValidade;
    private decimal? precoAtual;
    private string? iconeAtual;
    private bool usadoEmExpositorAtual;
    private string unidadeAtual = "kg";
    private string metodoArmazenagemAtual = "Temp. Ambiente";
    private bool salvando;
    private string? mensagem;

    protected override async Task OnInitializedAsync() => await CarregarProdutos();

    private async Task CarregarProdutos()
    {
        produtos = await Http.GetFromJsonAsync<List<Produto>>("produtos?contexto=produtos");
    }

    private void EditarClique(Produto produto)
    {
        editandoId = produto.Id;
        nome = produto.Nome;
        diasValidade = produto.DiasValidade;
        precoAtual = produto.Preco;
        iconeAtual = produto.Icone;
        usadoEmExpositorAtual = produto.UsadoEmExpositor;
        unidadeAtual = produto.Unidade;
        metodoArmazenagemAtual = produto.MetodoArmazenagem;
        mensagem = null;
    }

    private void CancelarEdicao()
    {
        editandoId = null;
        nome = "";
        diasValidade = 0;
        precoAtual = null;
        iconeAtual = null;
        usadoEmExpositorAtual = false;
        unidadeAtual = "kg";
        metodoArmazenagemAtual = "Temp. Ambiente";
    }

    private async Task Salvar()
    {
        if (string.IsNullOrWhiteSpace(nome))
        {
            mensagem = "Informe o nome do produto.";
            return;
        }

        salvando = true;
        var dados = new
        {
            Nome = nome,
            DiasValidade = diasValidade,
            Preco = precoAtual,
            Icone = iconeAtual,
            UsadoEmProdutos = true,
            UsadoEmExpositor = usadoEmExpositorAtual,
            Unidade = unidadeAtual,
            MetodoArmazenagem = metodoArmazenagemAtual
        };

        HttpResponseMessage response = editandoId is null
            ? await Http.PostAsJsonAsync("produtos", dados)
            : await Http.PutAsJsonAsync($"produtos/{editandoId}", dados);

        if (response.IsSuccessStatusCode)
        {
            mensagem = editandoId is null ? $"Produto \"{nome}\" cadastrado!" : "Produto atualizado!";
            CancelarEdicao();
            await CarregarProdutos();
        }
        else
        {
            mensagem = "Erro ao salvar produto.";
        }
        salvando = false;
    }

    private async Task RemoverClique(Produto produto)
    {
        var response = await Http.DeleteAsync($"produtos/{produto.Id}");
        if (response.IsSuccessStatusCode) await CarregarProdutos();
        else mensagem = "Erro ao remover produto.";
    }
}
