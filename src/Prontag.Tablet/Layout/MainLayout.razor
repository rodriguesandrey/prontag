@inherits LayoutComponentBase
@inject Prontag.Tablet.Services.AuthService Auth
@inject NavigationManager Nav

<div class="app-container">
    <div class="nav-superior">
        <div class="marca">
            <span class="marca-icone">P</span>
            <span class="marca-texto">Pront<span class="marca-destaque">ag</span></span>
        </div>
        @if (Auth.Autenticado)
        {
            <div class="nav-acoes">
                <span>@Auth.Nome</span>
                <a href="/">Início</a>
                <button @onclick="Sair">Sair</button>
            </div>
        }
    </div>

    @if (!pronto)
    {
        <p>Carregando...</p>
    }
    else if (!Auth.Autenticado && !Nav.Uri.EndsWith("/login"))
    {
        <p>Redirecionando para login...</p>
    }
    else
    {
        @Body
    }
</div>

@code {
    private bool pronto;

    protected override async Task OnInitializedAsync()
    {
        await Auth.InicializarAsync();
        pronto = true;

        if (!Auth.Autenticado && !Nav.Uri.EndsWith("/login"))
        {
            Nav.NavigateTo("/login");
        }
    }

    private async Task Sair()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}
